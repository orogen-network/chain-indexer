# Substrate RPC endpoint to follow. Default points at chain-node --dev.
RPC_ENDPOINT=ws://127.0.0.1:9944

# Subsquid Archive endpoint (gateway). Stub: leave empty to run pure-RPC mode.
ARCHIVE_GATEWAY=

# Where to start indexing from. 0 = genesis.
START_BLOCK=0

# Optional: cap the indexer at a height. Empty = follow tip.
STOP_BLOCK=

# Postgres connection used by the typeorm store.
DB_NAME=chain_indexer
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# GraphQL server port.
GRAPHQL_PORT=4350

# Log level (trace|debug|info|warn|error).
SQD_DEBUG=info
