{
  "name": "@orogen/chain-indexer",
  "version": "0.1.0",
  "description": "Subsquid archival indexer for the Orogen chain.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' 'schema.graphql'",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run processor:start:prod",
    "processor:start": "npm run processor:start:dev",
    "processor:start:dev": "OROGEN_ENV=${OROGEN_ENV:-development} node --enable-source-maps dist/main.js",
    "processor:start:prod": "OROGEN_ENV=production node --enable-source-maps dist/migrate.js && OROGEN_ENV=production node --enable-source-maps dist/main.js",
    "graphql:start": "squid-graphql-server --port ${GRAPHQL_PORT:-4350}",
    "db:init": "node --enable-source-maps dist/init-schema.js",
    "db:migrate": "node --enable-source-maps dist/migrate.js",
    "db:migration:generate": "node scripts/generate-initial-migration.mjs --write",
    "db:migration:check": "npm run build && node scripts/generate-initial-migration.mjs --check && node scripts/verify-migration-schema.mjs",
    "metadata:explore": "squid-substrate-metadata-explorer --rpc ${CHAIN_INDEXER_RPC_ENDPOINT:-ws://127.0.0.1:9944} --out metadata/specVersions.json",
    "codegen": "npm run codegen:models && npm run codegen:types && npm run codegen:post",
    "codegen:models": "squid-typeorm-codegen",
    "codegen:types": "squid-substrate-typegen typegen.json",
    "codegen:post": "node scripts/fix-generated-esm-imports.mjs",
    "generated:runtime-check": "npm run build && node -e \"await import('./dist/types/generated/bme/events.js'); await import('./dist/model/index.js'); await import('./dist/model/generated/index.js')\""
  },
  "dependencies": {
    "@subsquid/graphql-server": "^4.7.0",
    "@subsquid/substrate-processor": "^8.8.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.9.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/substrate-typegen": "^8.1.0",
    "@subsquid/typeorm-codegen": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  }
}
