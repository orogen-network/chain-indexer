{
  "name": "@useful/chain-indexer",
  "version": "0.1.0",
  "description": "Subsquid archival indexer for the Orogen chain.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' 'schema.graphql'",
    "test": "vitest run",
    "test:watch": "vitest",
    "processor:start": "node --enable-source-maps dist/main.js",
    "graphql:start": "squid-graphql-server --port ${GRAPHQL_PORT:-4350}",
    "db:init": "node --enable-source-maps dist/init-schema.js",
    "codegen": "echo 'sqd codegen would run here; types stubbed under src/types/'"
  },
  "dependencies": {
    "@subsquid/cli": "^3.3.0",
    "@subsquid/graphql-server": "^4.7.0",
    "@subsquid/substrate-processor": "^8.8.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.9.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
